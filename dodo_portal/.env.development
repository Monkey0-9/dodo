# Frontend dev environment — loaded by Vite automatically in `npm run dev`
# ─────────────────────────────────────────────────────────────────────────────
# Set to "true" to use mock data (no backend required for demos).
# Set to "false" to connect to the live FastAPI backend.
VITE_DEMO_MODE=false

# Backend REST API base (must be accessible from the browser).
# Vite proxy in vite.config.ts forwards /v1/** to this URL automatically.
VITE_API_BASE_URL=http://localhost:8283
